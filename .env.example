# Copy this file to `.env` and fill in the values you have. `.env` is
# gitignored and is the only place a key belongs: never on a command line,
# never in a settings file, never in a committed default.
#
#   cp .env.example .env     # then edit .env
#
# Nothing here is required to run the game or `npm run check`. Each key
# unlocks one optional thing, named below.

# Semantic search over the doctrine corpus in docs/Doctrine
# (tools/doctrine.py --semantic). The corpus stores a voyage-context-4
# embedding per chunk; this key is what lets a *query* be embedded so it can
# be compared against them. Without it the tool still works, by literal and
# regex text search. Keys are issued at https://dash.voyageai.com/
VOYAGE_API_KEY=

# Jev as the company commander (npm run jev-sim -- --jev).
TYPESAFE_API_KEY=

# A Claude model in Jev's place (npm run jev-sim -- --claude ...). Kept
# separate from ANTHROPIC_API_KEY so a cloud session's own key is not spent
# on simulated battles.
JEV_ANTHROPIC_API_KEY=
