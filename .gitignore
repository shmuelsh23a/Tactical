node_modules/
dist/
*.log
.DS_Store

# Per-developer Claude Code settings (permissions etc). The shared
# .claude/settings.json and launch.json stay tracked.
.claude/settings.local.json

# Python bytecode from the tools in tools/.
__pycache__/

# Jev battles played by tools/jev-sim.ts --jev: answers and call logs
jev-runs/

# The doctrine corpus in docs/Doctrine: the chunk index carries a 1024-dim
# embedding per chunk and runs to hundreds of MB, well past what GitHub will
# take. The manifest and documents.csv beside it stay tracked, so the repo
# still records which corpus a finding was read from (its sha256, the parse
# and the embedding model) even though the index itself is fetched, not
# versioned. Rebuild or re-publish the release to get it back.
docs/Doctrine/**/chunks.parquet

# Secrets. Keys live only here, never in a settings file, a command line or
# a committed default. .env.example records the NAMES a tool looks for and
# is the only one of these that is tracked.
.env
.env.*
!.env.example

# The vector matrix tools/doctrine.py --semantic caches beside the doctrine
# index: derived from chunks.parquet, the same hundreds of MB, and rebuilt
# in about fifteen seconds with --rebuild-vectors.
docs/Doctrine/**/vectors.*
